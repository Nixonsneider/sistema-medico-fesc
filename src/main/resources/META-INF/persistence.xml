<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <persistence-unit name="my_persistence_unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.nxn.sistemawebmedico.entity.Especialidad</class>
        <class>com.nxn.sistemawebmedico.entity.Medico</class>
        <class>com.nxn.sistemawebmedico.entity.Paciente</class>
        <class>com.nxn.sistemawebmedico.entity.Cita</class>
        <class>com.nxn.sistemawebmedico.entity.HistoriaClinica</class>
        <class>com.nxn.sistemawebmedico.entity.Orden</class>
        <class>com.nxn.sistemawebmedico.entity.Diagnostico</class>
        <class>com.nxn.sistemawebmedico.entity.Tratamiento</class>
        <class>com.nxn.sistemawebmedico.entity.DetalleOrden</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.jdbc.time_zone" value="America/Bogota"/>
        </properties>
    </persistence-unit>
</persistence>
